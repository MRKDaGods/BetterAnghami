<Window
  x:Class="MRK.ThemesWindow"
  x:Name="window"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:MRK"
  xmlns:conv="clr-namespace:MRK.Converters"
  xmlns:cp="clr-namespace:ColorPicker;assembly=ColorPicker"
  mc:Ignorable="d"
  Title="Better Anghami - Themes"
  Height="780"
  Width="1180"
  MinHeight="540"
  MinWidth="900"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource CustomWindowStyle}"
  DataContext="{RelativeSource Mode=Self}"
  Loaded="OnWindowLoaded"
  Closed="OnWindowClosed"
>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ColorPicker;component/Styles/DefaultColorPickerStyle.xaml" />

        <ResourceDictionary>
          <conv:StringToColorConverter x:Key="StringToColorConverter" />
          <conv:ColorToInvertedColorConverter x:Key="ColorToInvertedColorConverter" />
          <conv:ColorToReadableColorConverter x:Key="ColorToReadableColorConverter" />
          <conv:SelectedThemeConverter x:Key="SelectedThemeConverter" />
          <conv:FriendlyNameConverter x:Key="FriendlyNameConverter" />
          <conv:BooleanInverseConverter x:Key="BooleanInverseConverter" />
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="8, 12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Loading label -->
    <!-- Hide in design -->
    <Label
      x:Name="loadingLabel"
      Grid.RowSpan="2"
      Grid.ColumnSpan="2"
      Grid.ZIndex="99"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      HorizontalContentAlignment="Center"
      VerticalContentAlignment="Center"
      Background="#F10A0C0D"
      FontSize="36"
      d:Visibility="Hidden"
      Content="Loading themes"
    />

    <!-- Insalled themes toolbar -->
    <Grid Grid.Row="0" Grid.Column="0" Margin="0, 0, 4, 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Label Grid.Column="0" FontSize="24" FontWeight="Medium" Content="Installed Themes" />

      <!-- Create theme button -->
      <Button
        Grid.Column="1"
        Padding="16, 0"
        Height="30"
        Content="Create"
        Click="OnCreateThemeClick"
      />
    </Grid>

    <!-- No themes available label -->
    <Label
      x:Name="noThemesLabel"
      Grid.Row="1"
      Grid.Column="0"
      Grid.ZIndex="98"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      FontSize="24"
      d:Visibility="Hidden"
      FontWeight="Medium"
      Content="No themes available :("
    />

    <!-- Left sidebar -->
    <Grid Grid.Row="1" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Theme container (virtualized) -->
      <ListView
        x:Name="themesControl"
        BorderThickness="0"
        Background="Transparent"
        Margin="4, 4, 4, 0"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Standard"
        VirtualizingPanel.ScrollUnit="Item"
        d:ItemsSource="{d:SampleData ItemCount=3}"
      >
        <ListView.ItemContainerStyle>
          <Style TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListView.ItemContainerStyle>

        <ListView.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Width="360" />
          </ItemsPanelTemplate>
        </ListView.ItemsPanel>

        <ListView.ItemTemplate>
          <DataTemplate>
            <Border
              Tag="{Binding .}"
              Padding="0"
              Margin="0, 0, 0, 2"
              Cursor="Hand"
              MouseUp="OnThemeClick"
            >
              <Border
                x:Name="cardBorder"
                Background="{x:Static local:ThemesWindow.NormalContainerBrush}"
                Padding="0"
              >
                <Border.Resources>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <ColorAnimation
                                To="{x:Static local:ThemesWindow.ActiveContainerColor}"
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                Duration="0:0:0.18"
                                FillBehavior="HoldEnd"
                                RepeatBehavior="1x"
                              />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                          <BeginStoryboard>
                            <Storyboard>
                              <ColorAnimation
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                Duration="0:0:0.18"
                                FillBehavior="HoldEnd"
                                RepeatBehavior="1x"
                              />
                            </Storyboard>
                          </BeginStoryboard>
                        </Trigger.ExitActions>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Resources>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <!-- content -->
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <!-- Card content -->
                  <StackPanel Margin="10, 8, 10, 8">
                    <!-- Row 1: Name + indicators -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <TextBlock
                        Grid.Column="0"
                        FontWeight="SemiBold"
                        FontSize="15"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        Text="{Binding Name}"
                      />

                      <!-- Indicators -->
                      <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="6, 0, 0, 0"
                      >
                        <!-- Applied: this theme is live -->
                        <TextBlock
                          x:Name="selectedTextBlock"
                          FontSize="10"
                          Foreground="#7EC8A0"
                          VerticalAlignment="Center"
                          Margin="0, 0, 6, 0"
                          Text="Applied"
                          Visibility="Collapsed"
                          d:Visibility="Visible"
                        />

                        <!-- Built-In -->
                        <TextBlock
                          FontSize="10"
                          Foreground="#555C66"
                          VerticalAlignment="Center"
                          Text="Built-in"
                        >
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>

                    <!-- Row 2: Creator -->
                    <TextBlock
                      Margin="0, 3, 0, 0"
                      FontSize="12"
                      Foreground="#7A8390"
                      Text="{Binding CreatorName}"
                    />

                    <!-- Row 3: Description -->
                    <TextBlock
                      Margin="0, 5, 0, 0"
                      FontSize="12"
                      Foreground="#9AA5B4"
                      TextWrapping="Wrap"
                      Text="{Binding Description}"
                    />

                    <!-- Row 4: Version chip -->
                    <TextBlock Margin="0, 6, 0, 0" FontSize="10" Foreground="#555C66">
                      <Run Text="v" />
                      <Run Text="{Binding Version}" />
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Border>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- color picker -->
      <cp:StandardColorPicker
        x:Name="colorPicker"
        Grid.Row="1"
        Margin="5, 0"
        ColorChanged="OnColorPickerColorChanged"
        Visibility="Collapsed"
        d:Visibility="Visible"
      >
        <cp:StandardColorPicker.Style>
          <Style
            TargetType="cp:StandardColorPicker"
            BasedOn="{StaticResource DefaultColorPickerStyle}"
          >
            <Style.Resources>
              <!-- Main grid-->
              <Style TargetType="Grid">
                <Style.Triggers>
                  <Trigger Property="Name" Value="MainGrid">
                    <Setter Property="Background" Value="#1a1a1a" />
                  </Trigger>
                </Style.Triggers>
              </Style>

              <!-- Hex textbox -->
              <Style TargetType="cp:HexColorTextBox">
                <Setter Property="Margin" Value="0, 0, 0, 40" />
              </Style>

              <!-- Hex label -->
              <Style TargetType="Label">
                <Setter Property="Margin" Value="0, 0, 0, 40" />
              </Style>

              <!-- Hide HSL/HSV combobox, we default to HSV anyway -->
              <Style TargetType="ComboBox">
                <Setter Property="Visibility" Value="Collapsed" />
              </Style>

              <!-- Set to RGB tab by default -->
              <Style
                TargetType="{x:Type TabControl}"
                BasedOn="{StaticResource {x:Type TabControl}}"
              >
                <Setter Property="SelectedIndex" Value="2" />
              </Style>
            </Style.Resources>
          </Style>
        </cp:StandardColorPicker.Style>
      </cp:StandardColorPicker>
    </Grid>

    <!-- Editor header: info strip + toolbar -->
    <Grid Grid.Row="0" Grid.Column="1" Margin="12, 0, 0, 0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Row 0: Theme name + inline status -->
      <Grid Grid.Row="0" Margin="0, 0, 0, 6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock
            x:Name="editorThemeNameText"
            FontSize="18"
            FontWeight="SemiBold"
            VerticalAlignment="Center"
            Text="No theme selected"
          />

          <!-- Inline status text -->
          <TextBlock
            x:Name="editorReadOnlyBadge"
            Margin="8, 0, 0, 0"
            FontSize="11"
            Foreground="#888"
            VerticalAlignment="Center"
            Text="Read-only"
            Visibility="Collapsed"
            d:Visibility="Visible"
          />

          <TextBlock
            x:Name="editorDirtyBadge"
            Margin="8, 0, 0, 0"
            FontSize="11"
            Foreground="#C9A830"
            VerticalAlignment="Center"
            Text="Unsaved"
            Visibility="Collapsed"
            d:Visibility="Visible"
          />
        </StackPanel>

        <TextBlock
          x:Name="editorPropertyCountText"
          Grid.Column="1"
          FontSize="11"
          Foreground="#555C66"
          VerticalAlignment="Center"
        />
      </Grid>

      <!-- Row 1: Search + action buttons -->
      <Grid Grid.Row="1" Height="30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Search -->
        <Grid Margin="0, 0, 8, 0">
          <TextBox
            x:Name="searchTextBox"
            FontSize="12"
            VerticalContentAlignment="Center"
            Padding="8, 5"
            Height="26"
            Text=""
            TextChanged="OnSearchBoxTextChanged"
          />

          <!-- Watermark -->
          <TextBlock
            IsHitTestVisible="False"
            Text="Search properties"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Margin="10, 0, 0, 0"
            FontSize="12"
            Foreground="#555C66"
          >
            <TextBlock.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=searchTextBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <StackPanel.Resources>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Padding" Value="16, 0" />
              <Setter Property="Height" Value="26" />
              <Setter Property="FontSize" Value="12" />
            </Style>
          </StackPanel.Resources>

          <Button
            x:Name="applyThemeButton"
            Content="Apply Theme"
            ToolTip="Apply this theme to Anghami"
            Click="OnApplyThemeClick"
          />

          <Button
            x:Name="saveChangesButton"
            Content="Save"
            ToolTip="Save pending changes to disk"
            Click="OnSaveChangesClick"
          />

          <Button
            x:Name="editCssButton"
            Content="Edit CSS"
            ToolTip="Edit raw CSS for this theme"
            Click="OnEditThemeCssClick"
          />

          <Button
            x:Name="deleteThemeButton"
            Content="Delete"
            ToolTip="Permanently delete this theme"
            Click="OnDeleteThemeClick"
          />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Splitter-->
    <Rectangle
      Grid.Column="1"
      Grid.RowSpan="2"
      Margin="3, -30"
      Fill="#282828"
      Width="1"
      HorizontalAlignment="Left"
    />

    <!-- Theme editor -->
    <!-- Loading placeholder -->
    <Label
      x:Name="themePropertiesLoadingLabel"
      Grid.Row="1"
      Grid.Column="1"
      Grid.ZIndex="98"
      VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch"
      HorizontalContentAlignment="Center"
      VerticalContentAlignment="Center"
      Background="#0a0c0d"
      FontSize="24"
      Visibility="Collapsed"
      FontWeight="Medium"
      Content="Loading Theme Properties"
    />

    <!-- Main Container (virtualized ListView) -->
    <ListView
      x:Name="themePropertiesControl"
      Grid.Row="1"
      Grid.Column="1"
      Margin="12, 4, 0, 0"
      AlternationCount="2"
      BorderThickness="0"
      Background="Transparent"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      VirtualizingPanel.IsVirtualizing="True"
      VirtualizingPanel.VirtualizationMode="Standard"
      VirtualizingPanel.ScrollUnit="Item"
      d:ItemsSource="{d:SampleData ItemCount=33}"
    >
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListViewItem">
                <ContentPresenter />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListView.ItemContainerStyle>

      <ListView.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListView.ItemsPanel>

      <ListView.ItemTemplate>
        <DataTemplate>
          <Border
            x:Name="propContainer"
            Tag="{Binding .}"
            MinHeight="36"
            Background="#1a1a1a"
            BorderThickness="0, 0, 0, 1"
            BorderBrush="#111111"
          >
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F1F1F" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>

            <Grid Margin="10, 0, 6, 0">
              <Grid.ColumnDefinitions>
                <!-- Property name -->
                <ColumnDefinition Width="220" />
                <!-- Color chips -->
                <ColumnDefinition Width="Auto" />
                <!-- Textbox -->
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Property Name: friendly label + raw name as subtitle -->
              <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0, 4">
                <TextBlock
                  FontWeight="SemiBold"
                  FontSize="12"
                  TextTrimming="CharacterEllipsis"
                  Text="{Binding Name, Converter={StaticResource FriendlyNameConverter}}"
                  ToolTip="{Binding Name}"
                />
                <TextBlock
                  FontSize="10"
                  Foreground="#555C66"
                  TextTrimming="CharacterEllipsis"
                  Text="{Binding Name}"
                  ToolTip="{Binding Name}"
                />
              </StackPanel>

              <!-- Color chips -->
              <ItemsControl
                Grid.Column="1"
                Tag="{Binding .}"
                Loaded="OnColorChipsLoaded"
                VerticalAlignment="Center"
                d:ItemsSource="{d:SampleData ItemCount=2}"
              >
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border
                      Width="18"
                      Height="18"
                      CornerRadius="3"
                      Margin="2, 0"
                      Cursor="Hand"
                      Tag="{Binding .}"
                      MouseUp="OnThemeColorClick"
                      ToolTip="{Binding Value}"
                    >
                      <Border.Background>
                        <SolidColorBrush Color="{Binding Color}" />
                      </Border.Background>
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.5" />
                      </Border.Effect>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Property value textbox -->
              <TextBox
                Grid.Column="2"
                Tag="{Binding .}"
                d:Text="var(--mrk-color-primary)"
                Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                VerticalContentAlignment="Center"
                FontFamily="Consolas, Courier New"
                FontSize="11"
                TextChanged="OnValueTextboxChanged"
                Loaded="OnValueTextboxLoaded"
                LostFocus="OnValueTextboxFocusLost"
                SelectionChanged="OnValueTextboxSelectionChanged"
                Margin="6, 3, 0, 3"
                Padding="6, 4"
                IsReadOnly="{Binding SelectedTheme.IsBuiltIn, ElementName=window}"
                ToolTip="{Binding Value}"
              />
            </Grid>
          </Border>

          <DataTemplate.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
              <Setter Property="Background" Value="#1E1E1E" TargetName="propContainer" />
            </Trigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Window>
