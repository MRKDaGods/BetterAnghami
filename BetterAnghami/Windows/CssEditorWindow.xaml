<Window
  x:Name="window"
  x:Class="MRK.CssEditorWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:MRK"
  xmlns:conv="clr-namespace:MRK.Converters"
  mc:Ignorable="d"
  Title="CSS Editor"
  Height="700"
  Width="1050"
  MinHeight="400"
  MinWidth="600"
  WindowStartupLocation="CenterScreen"
  Style="{DynamicResource CustomWindowStyle}"
  DataContext="{RelativeSource Mode=Self}"
  Loaded="OnWindowLoaded"
>
  <Window.Resources>
    <conv:BooleanInverseConverter x:Key="BooleanInverseConverter" />

    <!-- Shared badge style -->
    <Style x:Key="BadgeStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8, 3" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- header -->
      <RowDefinition Height="Auto" />
      <!-- read-only banner -->
      <RowDefinition Height="*" />
      <!-- editor -->
      <RowDefinition Height="1" />
      <!-- separator -->
      <RowDefinition Height="26" />
      <!-- status bar -->
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border
      Grid.Row="0"
      Background="{DynamicResource Window.Static.Title.Background}"
      BorderBrush="{DynamicResource Window.Static.Border}"
      BorderThickness="0, 0, 0, 1"
      Padding="14, 10"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left: breadcrumb + theme name + badge -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock
            Text="Themes"
            FontSize="12"
            Foreground="{DynamicResource Window.Static.Foreground}"
            Opacity="0.45"
            VerticalAlignment="Center"
          />

          <TextBlock
            Text=" › "
            FontSize="12"
            Foreground="{DynamicResource Window.Static.Foreground}"
            Opacity="0.3"
            VerticalAlignment="Center"
          />

          <TextBlock
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="{DynamicResource Window.Static.Foreground}"
            VerticalAlignment="Center"
            d:Text="Deep Dark"
            Text="{Binding Theme.Name, ElementName=window}"
          />

          <!-- Read-only indicator (built-in only) -->
          <TextBlock
            FontSize="11"
            Foreground="#888"
            VerticalAlignment="Center"
            Margin="10, 0, 0, 0"
            Text="read-only"
          >
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Theme.IsBuiltIn, ElementName=window}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>

        <!-- Right: action buttons -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button
            Content="Reset"
            Padding="20, 6"
            Margin="0, 0, 8, 0"
            FontWeight="SemiBold"
            ToolTip="Discard changes and restore the original content"
            IsEnabled="{Binding Theme.IsBuiltIn, ElementName=window,
                                        Converter={StaticResource BooleanInverseConverter}}"
            Click="OnResetClick"
          />

          <Button
            Content="Apply"
            Padding="20, 6"
            FontWeight="SemiBold"
            ToolTip="Parse CSS and send changes back to the theme editor"
            IsEnabled="{Binding Theme.IsBuiltIn, ElementName=window,
                                        Converter={StaticResource BooleanInverseConverter}}"
            Click="OnApplyClick"
          />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Read-only warning banner (built-in themes) -->
    <Border
      Grid.Row="1"
      Background="#1E1507"
      BorderBrush="#6B4A1A"
      BorderThickness="0, 0, 0, 1"
      Padding="14, 7"
    >
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Theme.IsBuiltIn, ElementName=window}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock FontSize="12" Foreground="#C97A30" VerticalAlignment="Center">
        <Run FontWeight="SemiBold" Text="Read only: " />
        <Run Text="this is a built-in theme. Duplicate it first to make your own changes." />
      </TextBlock>
    </Border>

    <!-- CSS Editor -->
    <TextBox
      x:Name="contentTextbox"
      Grid.Row="2"
      FontSize="13"
      FontFamily="Consolas, Courier New, monospace"
      Background="{DynamicResource Window.Static.Background}"
      Foreground="{DynamicResource Window.Static.Foreground}"
      CaretBrush="{DynamicResource Window.Static.Foreground}"
      SelectionBrush="#264F78"
      BorderThickness="0"
      Padding="18, 14"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Auto"
      AcceptsReturn="True"
      AcceptsTab="True"
      TextWrapping="NoWrap"
      TextChanged="OnContentTextChanged"
      IsReadOnly="{Binding Theme.IsBuiltIn, ElementName=window}"
    />

    <!-- Separator line above status bar -->
    <Rectangle Grid.Row="3" Fill="{DynamicResource Window.Static.Border}" />

    <!-- Status bar -->
    <Border
      Grid.Row="4"
      Background="{DynamicResource Window.Static.Title.Background}"
      Padding="14, 0"
    >
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          x:Name="statusBarLeft"
          Grid.Column="0"
          FontSize="11"
          Foreground="{DynamicResource Window.Static.Foreground}"
          Opacity="0.45"
          VerticalAlignment="Center"
          Text="Ready"
        />

        <TextBlock
          x:Name="statusBarRight"
          Grid.Column="1"
          FontSize="11"
          Foreground="{DynamicResource Window.Static.Foreground}"
          Opacity="0.45"
          VerticalAlignment="Center"
        />
      </Grid>
    </Border>
  </Grid>
</Window>
